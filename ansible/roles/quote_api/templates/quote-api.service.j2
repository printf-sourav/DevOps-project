[Unit]
Description=Quote API
After=network.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_directory }}
Environment=APP_PORT={{ app_port }}
ExecStart=/usr/bin/java -jar {{ app_directory }}/quote-api.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
